# Пример конфигурации toursearch. Скопировать в .env, заполнить и НЕ коммитить.
# Все переменные опциональны кроме блока «прод» — но проверьте дефолты!
# Полная таблица — README раздел «Настройки веба».

# --- Безопасность ---
# Legacy-токен (для CI/curl/скриптов когда нет юзеров в БД). В мультиюзере не нужен.
# TOURSEARCH_TOKEN=

# Разрешить старт НЕ на localhost без TLS. В проде ТОЛЬКО за TLS-прокси.
# TOURSEARCH_ALLOW_INSECURE=1

# Форс Secure-cookie + HSTS на 127.0.0.1 (когда TLS терминируется в прокси).
TOURSEARCH_SECURE_COOKIES=1

# ВАЖНО при работе за reverse-proxy: см. README раздел «Деплой за reverse-proxy».
# uvicorn должен быть запущен с --proxy-headers --forwarded-allow-ips=<IP_прокси>,
# иначе rate-limit и анти-брутфорс будут видеть всех с одного IP=127.0.0.1.
TOURSEARCH_BEHIND_PROXY=1

# --- Оплата ---
# stub — заглушка (без денег!): «оплату» подтверждает кнопка внутри приложения.
# yookassa ещё НЕ реализована (план Ф1, см. docs/BILLING_PLAN.md) — с ней checkout
# создаёт платёж без confirmation_url и подтвердить его НЕЧЕМ. Не включайте её.
# КРИТИЧНО: stub «не на localhost» = бесплатные подписки, поэтому create_app падает
# с RuntimeError при старте наружу (fail-fast). Для демо наружу без оплаты нужен
# осознанный TOURSEARCH_ALLOW_INSECURE=1.
# TOURSEARCH_PAYMENT_PROVIDER=stub

# --- Производительность ---
TOURSEARCH_MAX_CONCURRENT_SEARCHES=3
TOURSEARCH_PROVIDER_TIMEOUT_S=180
TOURSEARCH_PROVIDER_RETRIES=1
TOURSEARCH_TEST_CONCURRENCY=4
TOURSEARCH_HEALTHCHECK_TTL_S=60

# --- Эксплуатация ---
# Хранить прогоны/уведомления N дней (0 = выключить retention).
TOURSEARCH_RETENTION_DAYS=90

# Лимит тела запроса (256 KB = 262144 байт).
TOURSEARCH_MAX_BODY_BYTES=262144

# Формат логов (text | json). json — для ELK/Loki/Cloud Logging.
TOURSEARCH_LOG_FORMAT=json

# --- Для docker-compose init-auth ---
# Пароль первого админа (передаётся через `init-auth --password-from-env ADMIN_PASSWORD`).
# После создания админа можно удалить.
# ADMIN_PASSWORD=
